# Copy this file to .env and fill in your values.

# ---- AI (Anthropic Claude) ----
# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: the Claude model to use (defaults to claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Auth0 (authentication) ----
# From your Auth0 "Regular Web Application" settings.
# Issuer/domain, e.g. https://your-tenant.us.auth0.com
ISSUER_BASE_URL=
# Application Client ID (not a secret).
CLIENT_ID=
# A long random string used to encrypt the session cookie. Generate your own,
# e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Public base URL of the app (must match Auth0 Allowed Callback/Logout URLs).
# Local: http://localhost:3000   Render: https://ask-adam.onrender.com
BASE_URL=http://localhost:3000

# ---- App ----
# Port (Render sets this automatically; used only for local dev).
PORT=3000
# Number of free Ask Adam questions per day per user (defaults to 5).
FREE_DAILY_LIMIT=5
# Set to "production" on Render.
NODE_ENV=development

# ---- Database ----
# Postgres connection string. If empty, the app uses an in-memory store (local dev only).
# On Render this is provided automatically by the managed Postgres database.
# The database needs the pgvector extension (auto-enabled on boot) for AI memory.
DATABASE_URL=

# ---- Embeddings (AI long-term memory / RAG) ----
# MongoDB Voyage AI "Model API Key" from https://ai.mongodb.com. Enables semantic memory.
# Without it, chat still works but Adam won't have long-term recall.
EMBEDDINGS_API_KEY=
# Optional overrides:
EMBEDDING_MODEL=voyage-3.5-lite
EMBEDDING_DIM=1024
