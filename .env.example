# Copy this file to .env and fill in your values.

# ---- AI (Anthropic Claude) ----
# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: the Claude model to use (defaults to claude-3-5-sonnet-latest).
# Cheaper option: claude-3-5-haiku-latest
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Only needed if your key is an identity-linked/org-level key (not a normal
# workspace key). Standard workspace API keys do NOT need this.
ANTHROPIC_WORKSPACE_ID=

# ---- App ----
# Public base URL of the app. Used to build OAuth callback URLs.
# Local: http://localhost:3000   Render: https://your-app.onrender.com
APP_URL=http://localhost:3000
# Port (Render sets this automatically; used only for local dev).
PORT=3000
# Number of free Ask Adam questions per day per user (defaults to 5).
FREE_DAILY_LIMIT=5
# Set to "production" on Render. Disables dev login unless ALLOW_DEV_LOGIN=true.
NODE_ENV=development

# ---- Sessions ----
# Long random string used to sign session cookies. Generate one, keep it secret.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Postgres connection string. If empty, the app uses an in-memory store (local dev only).
# On Render this is provided automatically by the managed Postgres database.
DATABASE_URL=

# ---- Auth: Google ----
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Auth: Facebook ----
# Create an app at https://developers.facebook.com/apps
# Valid OAuth Redirect URI: {APP_URL}/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Dev login (testing only) ----
# When "true", enables an email-only login (no password) for testing without OAuth.
# Leave unset in production, or it defaults to enabled only when NODE_ENV != production.
ALLOW_DEV_LOGIN=true
